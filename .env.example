# Copy to .env and fill in real values. Never commit .env.
# NOTE: VITE_-prefixed variables are embedded in the public client bundle.

# EmailJS account 1 — booking emails (admin notification + customer confirmation)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=

# EmailJS account 2 — enquiry (Contact / Partners / journey enquiry) +
# personalised-tour templates
VITE_EMAILJS2_SERVICE_ID=service_igsc3al
VITE_EMAILJS2_PUBLIC_KEY=a2-DW6lNOl8sFeiwL
VITE_EMAILJS2_ENQUIRY_TEMPLATE_ID=template_z0q8wg7
VITE_EMAILJS2_PERSONALISED_TEMPLATE_ID=template_km385j1

# Google Calendar + Sheets — the booking store. Server-side only: the
# Netlify Functions (/api/availability, /api/submit) and their dev mirror in
# admin-server/dev-api.js. NEVER add a VITE_ prefix — this key never expires,
# so leaking it into the client bundle is permanent.
#
# GOOGLE_SA_KEY_B64 is the whole service-account JSON, base64'd onto ONE line
# (the .env parser is single-line, so a raw PEM cannot go here):
#   base64 -i service-account.json | tr -d '\n'
#
# LOCALLY, point these at the THROWAWAY dev calendar and dev sheet — otherwise
# every test booking lands on the real calendar (i.e. on your phone) and holds
# seats that were never sold.
#
# Setup walkthrough: docs/google-calendar-setup.md
GOOGLE_SA_KEY_B64=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

VITE_ORS_API_KEY=

# Google Places API (New) — server-side only: the build-time review sync
# (scripts/sync-google-reviews.mjs). NEVER add a VITE_ prefix. The Place ID
# normally lives in /admin → Settings; set it here only to override.
# Setup walkthrough: docs/google-reviews-setup.md
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACE_ID=
