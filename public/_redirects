# The blog was rebranded to "The Journal". Permanently redirect old URLs
# so existing search rankings and inbound links follow to the new path.
# (Honoured by Netlify-style hosts; a client-side fallback also exists in App.jsx.)
/blog              /journal            301
/blog/*            /journal/:splat     301

# Journey detail pages moved under their listing: /packages/:slug is now
# /multi-day-tours/:slug. Same reasoning — preserve rankings and old links.
/packages          /multi-day-tours            301
/packages/*        /multi-day-tours/:splat     301

# Serverless API (availability + booking submissions → Google Calendar). Must sit
# above the SPA fallback or /api/* would return 200.html instead.
/api/*    /.netlify/functions/:splat    200

# SPA fallback — let the client router handle everything else.
# 200.html is the pristine tag-free shell captured by scripts/prerender.mjs;
# falling back to index.html would serve the prerendered HOMEPAGE (its title,
# meta and canonical) for every non-prerendered URL — Google then indexes
# those pages as homepage duplicates.
/*    /200.html    200
